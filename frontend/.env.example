# ==========================================
# KaratFlow Frontend Environment Configuration
# ==========================================

# Backend REST API Server URL
# - Local Development: http://localhost:8888
# - Production Domain: https://api.yourdomain.com
VITE_API_BASE_URL=http://localhost:8888

# Backend WebSocket URL (Optional: auto-calculated from VITE_API_BASE_URL if omitted)
# - Local: ws://localhost:8888/ws-alerts-raw
# - Production: wss://api.yourdomain.com/ws-alerts-raw
# VITE_WS_URL=ws://localhost:8888/ws-alerts-raw
